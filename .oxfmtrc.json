{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 140,
  "trailingComma": "es5",
  "semi": false,
  "singleQuote": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "insertFinalNewline": true,
  "ignorePatterns": ["plugin/dist", "dist", "pnpm-lock.yaml", ".impeccable", "**/*.md"]
}
