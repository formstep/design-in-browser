{
  "manifest_version": 3,
  "name": "Design in Browser",
  "version": "0.1.0",
  "description": "Comment on your local app's UI and send the comments to a running Claude Code session.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["sidePanel", "storage", "alarms"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*.localhost/*",
    "https://localhost/*",
    "https://*.localhost/*",
    "http://*.test/*",
    "https://*.test/*"
  ],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://*.localhost/*",
        "https://localhost/*",
        "https://*.localhost/*",
        "http://*.test/*",
        "https://*.test/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Design in Browser" }
}
